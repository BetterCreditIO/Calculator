{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoodBoyPdf",
  "mainBinaryName": "GoodBoyPdf",
  "version": "1.0.0",
  "identifier": "com.goodboylabs.goodboypdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "GoodBoyPdf",
        "label": "main",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Goodboy Labs",
    "copyright": "© 2026 Goodboy Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "GoodBoyPdf — premium PDF editor with an integrated Illinois mortgage calculator. By Goodboy Labs.",
    "longDescription": "GoodBoyPdf is a fast, high-fidelity desktop PDF editor for professionals, produced by Goodboy Labs. Read, mark up, and edit PDFs with pixel-accurate rendering, organize pages, and run mortgage and affordability scenarios using realistic Illinois property-tax and insurance estimates.",
    "createUpdaterArtifacts": true,
    "resources": {
      "lib/pdfium.dll": "pdfium.dll"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.goodboylabs.com/goodboypdf/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_YOUR_TAURI_UPDATER_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
